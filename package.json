{
  "name": "@wittywilla/wittyebook",
  "version": "0.4.1",
  "description": "A reader for reflowable ebooks (EPUB): book view, typography, highlights, notes, handwriting with pen pressure, search and read aloud.",
  "license": "AGPL-3.0-or-later",
  "author": "WittyWilla (https://github.com/wittywilla)",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./*.css": "./*.css"
  },
  "scripts": {
    "build:bundle": "node ${WITTYMODULE:-../WittyModule}/kit/web/build-bundle.mjs .",
    "test": "node sdui/kit/write-sdui.mjs --check sdui.json && node --test scripts/test-web.mjs"
  },
  "repository": "github:wittywilla/WittyEbook",
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@wittywilla/wittyink": "github:wittywilla/WittyInk#v0.4.1"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
