{
  "format": "wittymodule-sdui",
  "formatVersion": 1,
  "module": "wittyebook",
  "catalog": 7,
  "theme": {
    "scope": "wittyebook",
    "label": "EPUB reader"
  },
  "settings": [
    {
      "id": "wittyebook",
      "title": "Books",
      "icon": "book",
      "groups": [
        {
          "title": "Text and display",
          "footer": "Your choices in a book change these too, so every device opens books the same way.",
          "rows": [
            {
              "key": "layout",
              "kind": "enum",
              "scope": "profile",
              "label": "Layout",
              "default": "auto",
              "options": [
                {
                  "value": "auto",
                  "label": "Auto"
                },
                {
                  "value": "single",
                  "label": "One page"
                },
                {
                  "value": "book",
                  "label": "Book view"
                },
                {
                  "value": "scroll",
                  "label": "Scroll"
                }
              ]
            },
            {
              "key": "pageColour",
              "kind": "enum",
              "scope": "profile",
              "label": "Page colour",
              "default": "light",
              "options": [
                {
                  "value": "light",
                  "label": "White"
                },
                {
                  "value": "sepia",
                  "label": "Sepia"
                },
                {
                  "value": "dark",
                  "label": "Night"
                },
                {
                  "value": "black",
                  "label": "Black"
                }
              ]
            },
            {
              "key": "font",
              "kind": "enum",
              "scope": "profile",
              "label": "Font",
              "default": "publisher",
              "options": [
                {
                  "value": "publisher",
                  "label": "The book's own"
                },
                {
                  "value": "serif",
                  "label": "Serif"
                },
                {
                  "value": "sans",
                  "label": "Sans serif"
                },
                {
                  "value": "readable",
                  "label": "Easy to read"
                },
                {
                  "value": "mono",
                  "label": "Monospace"
                }
              ]
            },
            {
              "key": "textSize",
              "kind": "int",
              "scope": "profile",
              "label": "Text size",
              "default": 100,
              "min": 60,
              "max": 250,
              "unit": "%"
            },
            {
              "key": "lineSpacing",
              "kind": "int",
              "scope": "profile",
              "label": "Line spacing",
              "default": 155,
              "min": 110,
              "max": 220,
              "unit": "%"
            },
            {
              "key": "margins",
              "kind": "int",
              "scope": "profile",
              "label": "Margins",
              "help": "0 none, 6 widest.",
              "default": 2,
              "min": 0,
              "max": 6
            },
            {
              "key": "justify",
              "kind": "bool",
              "scope": "profile",
              "label": "Justify and hyphenate",
              "default": true
            }
          ]
        },
        {
          "title": "Light",
          "rows": [
            {
              "key": "brightness",
              "kind": "int",
              "scope": "profile",
              "label": "Brightness",
              "default": 100,
              "min": 35,
              "max": 100,
              "unit": "%"
            },
            {
              "key": "warmth",
              "kind": "int",
              "scope": "profile",
              "label": "Warmth (night light)",
              "help": "Off at 0%.",
              "default": 0,
              "min": 0,
              "max": 100,
              "unit": "%"
            }
          ]
        },
        {
          "title": "Read aloud",
          "footer": "Read aloud starts from where you are, with the device's own voice.",
          "rows": [
            {
              "key": "readAloudSpeed",
              "kind": "enum",
              "scope": "profile",
              "label": "Speed",
              "default": "1",
              "options": [
                {
                  "value": "0.75",
                  "label": "0.75×"
                },
                {
                  "value": "1",
                  "label": "1×"
                },
                {
                  "value": "1.25",
                  "label": "1.25×"
                },
                {
                  "value": "1.5",
                  "label": "1.5×"
                },
                {
                  "value": "2",
                  "label": "2×"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
